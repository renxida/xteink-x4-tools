#!/usr/bin/env python3
"""
Sweep typography variants on a source EPUB and emit PNG previews.

Renders each variant using --xtc-max-pages so each run is a few seconds
even on a long book. Drops the XTC + a sample page into variants/<slug>/.
"""
import json
import os
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SOURCE = ROOT / "samples" / "player_of_games.epub"
OUT_DIR = ROOT / "samples" / "variants"
EXTRACT = ROOT / "calibre-xtc" / "tests" / "extract_xtc.py"
WRAPPER = ROOT / "bin" / "epub2xtc"

# Page in the rendered XTC to extract for the preview. Cover is page 1; PoG's
# front matter (title, copyright, "Culture Plate" intro) eats roughly 14 pages
# at default density, so we render past it and pick a deep prose page.
SAMPLE_PAGE = 18      # 1-based
MAX_PAGES = 20        # cap per render


# Each variant: a slug (filesystem-safe), a human description, env-var overrides
# layered onto the wrapper's defaults, plus extra ebook-convert flags.
def font(name, desc, **extra):
    return {
        "slug": f"font-{slugify(name)}",
        "category": "font",
        "desc": f"{name} — {desc}",
        "env": {"XTC_FONT_FAMILY": name, **extra.get("env", {})},
        "flags": [],
    }


def setting(slug, desc, env=None, flags=None):
    return {
        "slug": f"setting-{slug}",
        "category": "setting",
        "desc": desc,
        "env": env or {},
        "flags": flags or [],
    }


def landscape(slug, desc, env=None, zoom=None):
    """Landscape variant. Optional `zoom` overrides --xtc-zoom for per-font
    calibration so all fonts produce roughly the same text-per-page."""
    flags = ["--xtc-orientation", "landscape-right"]
    if zoom is not None:
        flags += ["--xtc-zoom", f"{zoom}"]
    return {
        "slug": f"landscape-{slug}",
        "category": "landscape",
        "desc": desc,
        "env": env or {},
        "flags": flags,
    }


def slugify(s):
    return s.lower().replace(" ", "-").replace(",", "")


