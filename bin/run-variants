def render(v):
    out_dir = OUT_DIR / v["slug"]
    out_dir.mkdir(parents=True, exist_ok=True)
    xtc_path = out_dir / "out.xtc"
    if xtc_path.exists():
        xtc_path.unlink()

    env = {**os.environ, **v["env"]}
    cmd = [str(WRAPPER), str(SOURCE), str(xtc_path),
           "--xtc-max-pages", str(MAX_PAGES), *v["flags"]]
    t0 = time.perf_counter()
    proc = subprocess.run(cmd, env=env, capture_output=True, text=True)
    elapsed = time.perf_counter() - t0

    if proc.returncode != 0:
        return {"error": proc.stderr.splitlines()[-1] if proc.stderr else "non-zero exit",
                "elapsed_s": elapsed}

    # Probe page count via verifier (cheap)
    info_cmd = ["calibre-debug", "-e", str(EXTRACT), "--", str(xtc_path), "--info"]
    info = subprocess.run(info_cmd, capture_output=True, text=True)
    page_count = None
    for line in info.stdout.splitlines():
        if line.strip().startswith("Pages:"):
            page_count = int(line.split(":")[1].strip())
            break

    # Extract the chosen sample page. Variants can override SAMPLE_PAGE — useful
    # for dropcap which only fires on chapter-opening pages.
    target_page = v.get("sample_page", SAMPLE_PAGE)
    sample = min(target_page, page_count) if page_count else target_page
    # Clean stale extracted PNGs (including any prior preview) before extracting,
    # so the glob below only sees the new file.
    for p in out_dir.glob("*.png"):
        p.unlink()
    ext_cmd = ["calibre-debug", "-e", str(EXTRACT), "--",
               str(xtc_path), "-p", str(sample), "-o", str(out_dir)]
    subprocess.run(ext_cmd, capture_output=True)
    pngs = list(out_dir.glob("*.png"))
    sample_png = pngs[0] if pngs else None
    if sample_png:
        stable = out_dir / "preview.png"
        sample_png.rename(stable)
        sample_png = stable

    return {
        "elapsed_s": round(elapsed, 2),
        "page_count": page_count,
        "preview_page": sample,
        "xtc_bytes": xtc_path.stat().st_size,
        "preview_png": str(sample_png.relative_to(ROOT)) if sample_png else None,
    }


def main():
    OUT_DIR.mkdir(parents=True, exist_ok=True)
    # Optional substring filter: ./run-variants landscape  → only landscape-* variants.
    filt = sys.argv[1] if len(sys.argv) > 1 else None
    selected = [v for v in VARIANTS if not filt or filt in v["slug"]]
    if filt:
        print(f"Filter '{filt}': {len(selected)}/{len(VARIANTS)} variants")
    # Preserve previously-computed entries for variants we're not re-rendering.
    existing = {}
    if filt and (OUT_DIR / "results.json").exists():
        existing = {r["slug"]: r for r in json.loads((OUT_DIR / "results.json").read_text())}
    results = []
    for v in selected:
        sys.stdout.write(f"[ ] {v['slug']:35s} ")
        sys.stdout.flush()
        r = render(v)
        v_result = {**v, **r}
        results.append(v_result)
        if "error" in r:
            print(f"  FAIL ({r.get('elapsed_s', '?')}s): {r['error']}")
        else:
            print(f"  ok  ({r['elapsed_s']}s, {r['page_count']} pages)")

    # Merge with existing if a filter narrowed the set.
    if existing:
        merged = list(existing.values())
        new_slugs = {r["slug"] for r in results}
        merged = [r for r in merged if r["slug"] not in new_slugs] + results
        results = merged
    summary = OUT_DIR / "results.json"
    summary.write_text(json.dumps(results, indent=2, default=str))
    print(f"\nResults: {summary}")


if __name__ == "__main__":
    main()
